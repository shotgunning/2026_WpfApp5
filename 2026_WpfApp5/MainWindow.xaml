<Window x:Class="_2026_WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_WpfApp5"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="WPF小畫家ver2" Height="589" Width="1057">
	<DockPanel>
		<!-- 選單列 -->
		<Menu DockPanel.Dock="Top" Height="30">
			<MenuItem Header="檔案" Height="30" VerticalAlignment="Center" FontSize="16">
				<MenuItem Header="開啟新畫布" VerticalAlignment="Center" FontSize="16"/>
				<MenuItem Header="儲存畫布" VerticalAlignment="Center" FontSize="16"/>
			</MenuItem>
		</Menu>

		<!-- 工具列托盤 -->
		<ToolBarTray Height="40" Background="LightCyan" DockPanel.Dock="Top">
			<ToolBar Height="38" Width="600" Background="#FFD4F9C7">
				<Label Content="筆刷色彩" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
				<xctk:ColorPicker x:Name="StrokeColorPicker" Width="100" Height="30" DisplayColorAndName="True" SelectedColorChanged="StrokeColorPicker_SelectedColorChanged"/>

				<Label Content="填滿色彩" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"/>
				<xctk:ColorPicker x:Name="FillColorPicker" Width="100" Height="30" DisplayColorAndName="True" SelectedColorChanged="FillColorPicker_SelectedColorChanged"/>

				<Slider x:Name="ThicknessSlider" Width="120" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="30,0,0,0" ValueChanged="ThicknessSlider_ValueChanged"/>
				<Label FontSize="14" FontWeight="Bold" Margin="20,0,0,0" Content="{Binding Value, ElementName=ThicknessSlider}" Foreground="#FFF70909" VerticalAlignment="Center"/>
			</ToolBar>

			<ToolBar Height="38" Width="600" Background="#FFFBC2C2">
				<RadioButton Height="35" Width="35" FontSize="16" Checked="ShapeButton_Checked" FontWeight="Bold" Tag="Line" IsChecked="True">
					<Image Source="/img/line.png" />
				</RadioButton>
				<RadioButton Height="35" Width="35" FontSize="16" Checked="ShapeButton_Checked" FontWeight="Bold" Tag="Rectangle">
					<Image Source="/img/rectangle.png" />
				</RadioButton>
				<RadioButton Height="35" Width="35" FontSize="16" Checked="ShapeButton_Checked" FontWeight="Bold" Tag="Ellipse">
					<Image Source="/img/ellipse.png" />
				</RadioButton>
				<RadioButton Height="35" Width="35" FontSize="16" Checked="ShapeButton_Checked" FontWeight="Bold" Tag="Polyline">
					<Image Source="/img/polyline.png" />
				</RadioButton>
				<Separator/>
				<Button x:Name="EraserButton" Width="35" Height="35" Tag="Eraser" Click="EraserButton_Click">
					<Image Source="/img/eraser.png"/>
				</Button>
				<Button x:Name="ClearButton" Width="35" Height="35" Tag="Clear" Click="ClearButton_Click">
					<Image Source="/img/trashcan.png"/>
				</Button>
			</ToolBar>
		</ToolBarTray>

		<!-- 狀態列 -->
		<StatusBar Height="35" Background="LightGray" DockPanel.Dock="Bottom">
			<StatusBarItem Width="400">
				<Label x:Name="StatusLabel" Content="Ready" VerticalAlignment="Center" FontSize="14" Width="350" Margin="10,0,0,0"/>
			</StatusBarItem>
			<Separator/>
			<StatusBarItem Width="200">
				<Label x:Name="ShapeLabel" Content="形狀" VerticalAlignment="Center" FontSize="14" Width="150" Margin="10,0,0,0"/>
			</StatusBarItem>
			<Separator/>
			<StatusBarItem>
				<Label x:Name="ColorLabel" Content="色彩" VerticalAlignment="Center" FontSize="14" Margin="10,0,0,0"/>
			</StatusBarItem>
		</StatusBar>

		<!-- 主繪圖區 -->
		<Canvas x:Name="MyCanvas" Background="#FFE7F5F3"
                MouseEnter="MyCanvas_MouseEnter"
                MouseLeftButtonDown="MyCanvas_MouseLeftButtonDown"
                MouseMove="MyCanvas_MouseMove"
                MouseLeftButtonUp="MyCanvas_MouseLeftButtonUp"/>
	</DockPanel>
</Window>